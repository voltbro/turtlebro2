export ROS_DOMAIN_ID=1
export ROBOT_IP=$(hostname  -I | cut -f1 -d' ')
# [turtlebro2|turtlebro] value 
export ROBOT_MODEL=turtlebro2
export ROBOT_WHEEL_PARAM=12280

export RMW_IMPLEMENTATION=rmw_fastrtps_cpp
export FASTRTPS_DEFAULT_PROFILES_FILE=/home/pi/.ros/fastdds_superclient.xml

# Extra network settings
#export ROS_DISCOVERY_SERVER="127.0.0.1:11811"
#export ROS_DISCOVERY_SERVER="TCPv4:[192.168.51.214]:42100"
#export ROS_SUPER_CLIENT=TRUE

# for "blue" board set 5
# for "gold" board last number. 2.7 -> 7
export BOARD_VERSION=7

if [ $BOARD_VERSION -le 6 ]
then
  export CP_NAME=CP2102
else
  export CP_NAME=CP2102N
fi
